{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash|Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/deny-secrets.sh" }
        ]
      }
    ]
  }
}
